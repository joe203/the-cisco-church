# Copy to .env (production) or .env.local (development) and fill in.
# Without the Supabase values the site runs on bundled seed data.

NEXT_PUBLIC_SUPABASE_URL=https://supabase.concan.church
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only — never NEXT_PUBLIC_
PRESENTER_KEY=choose-a-long-random-secret          # unlocks /slides/[deck]/present
