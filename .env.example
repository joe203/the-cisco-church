# Copy to .env (production) or .env.local (development) and fill in.
# Without the Supabase values the site runs on bundled seed data.

NEXT_PUBLIC_SUPABASE_URL=https://supabase.concan.church
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only — never NEXT_PUBLIC_
PRESENTER_KEY=choose-a-long-random-secret          # unlocks /slides/[deck]/controls
ANTHROPIC_API_KEY=your-anthropic-key              # server only — reads uploaded paper bulletins (/staff); leave unset to turn uploads off
MAILGUN_SENDING_KEY=your-mailgun-domain-sending-key   # server only — scoped to theciscochurch.org; sends the "draft ready" replies
MAILGUN_SIGNING_KEY=your-mailgun-webhook-signing-key  # server only — verifies inbound bulletin email really came from Mailgun
# Optional — text message to the church admin when new mail arrives (off unless MAIL_ALERT_SMS_ENABLED=true)
MAIL_ALERT_SMS_ENABLED=false
OPERATOR_PHONE=+1XXXXXXXXXX
TELNYX_API_KEY=your-telnyx-key
TELNYX_FROM_NUMBER=+1XXXXXXXXXX
